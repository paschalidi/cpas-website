graph LR
    API["Campaign & Enrollment API"]
    Bulk["Bulk Enrollment Job"]
    Scanner["Scanner / Scheduler"]
    Relay["Outbox Relay"]
    Workers["Channel Workers (Email / SMS)"]
    Providers["Email / SMS Providers"]
    PG[("Postgres: versions, cursor, attempts, outbox")]
    Redis[("Redis: rate limits")]
    Queue[["Message Queue"]]

    API --> PG
    Bulk --> PG
    Scanner -->|claim due + TX write outbox| PG
    Relay -->|poll outbox| PG
